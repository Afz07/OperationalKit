# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#
# The default below matches the included docker-compose.yml — just run
# `docker compose up -d` and it works out of the box for local development.
#
# For production: on Railway this is provided automatically when you add a
# PostgreSQL plugin; on Supabase/Neon copy it from your project settings
# (those usually require ?sslmode=require at the end).
DATABASE_URL="postgresql://operationalkit:operationalkit@localhost:5432/operationalkit"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random secret used to sign NextAuth session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# ─── OAuth — GitHub ───────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:      http://localhost:3000
# Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# ─── OAuth — Google ───────────────────────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_secret_key"

# Webhook signing secret — from https://dashboard.stripe.com/webhooks
# For local dev, use: stripe listen --forward-to localhost:3000/api/stripe/webhook
# The CLI prints the signing secret (whsec_...) when it starts
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_webhook_signing_secret"

# Price ID for the Pro plan — create a recurring price at https://dashboard.stripe.com/products
# Must match the $29/month price you configure in Stripe
STRIPE_PRO_PRICE_ID="price_replace_with_your_pro_plan_price_id"

# ─── Resend (email) ───────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_replace_with_your_resend_api_key"

# The "from" address for all outbound emails.
# Must be a domain you have verified in Resend (https://resend.com/domains).
# For local testing you can use: onboarding@resend.dev (Resend's shared test domain)
EMAIL_FROM="noreply@yourdomain.com"

# ─── App ──────────────────────────────────────────────────────────────────────
# The public base URL of the app — used to build invite links and Stripe redirect URLs.
# In development: http://localhost:3000
# In production: https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of email addresses that can access the /admin panel.
# Example: "alice@example.com,bob@example.com"
ADMIN_EMAILS="your@email.com"
